{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*", "../../packages/ui-web/src/*"],
      "@/./*": ["../../packages/ui-web/src/*"],
      "@gv-tech/design-tokens": ["../../packages/design-tokens/src"],
      "@gv-tech/ui-core": ["../../packages/ui-core/src"],
      "@gv-tech/ui-web": ["../../packages/ui-web/src"],
      "@gv-tech/ui-native": ["../../packages/ui-native/src"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    "../../packages/design-tokens/src",
    "../../packages/ui-core/src",
    "../../packages/ui-web/src",
    "../../packages/ui-native/src"
  ]
}
