{
  "name": "ui-flutter",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui-flutter/lib",
  "targets": {
    "flutter-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter test",
        "cwd": "packages/ui-flutter"
      }
    },
    "flutter-analyze": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter analyze",
        "cwd": "packages/ui-flutter"
      }
    }
  }
}
